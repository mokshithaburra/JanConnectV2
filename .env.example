# Server
NODE_ENV=development
PORT=3000
# Leave sslmode out of the URL: in production the app enables TLS itself.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# Optional: PEM CA certificate to verify the database's TLS certificate (production)
DATABASE_CA_CERT=
# Optional: max pooled connections (default 10)
DATABASE_POOL_MAX=
# At least 32 characters in production
JWT_SECRET=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# openId (Google "sub") of the user who becomes admin on first login
OWNER_OPEN_ID=

# Supabase Storage (server-side only; private bucket "post-media")
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Client (exposed to the browser at build time)
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_MAPS_API_KEY=
