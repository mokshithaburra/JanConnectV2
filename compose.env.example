# Copy this file to .env locally. Never commit the copied .env file.
POSTGRES_DB=janconnect
POSTGRES_USER=janconnect
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_PORT=5432
APP_PORT=3000
JWT_SECRET=replace-with-a-long-random-secret

# Public frontend values required during the image build
VITE_APP_ID=local-janconnect
VITE_APP_TITLE=JanConnect
VITE_APP_LOGO=
VITE_OAUTH_PORTAL_URL=
VITE_FRONTEND_FORGE_API_URL=
VITE_FRONTEND_FORGE_API_KEY=

# Optional server integration values
OAUTH_SERVER_URL=
OWNER_OPEN_ID=local-owner
OWNER_NAME=Local Owner
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
